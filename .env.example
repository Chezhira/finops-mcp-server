# Finance AI Ecosystem MCP Server — environment variables
# Copy this to .env and fill in your values.
# NEVER commit .env to git.

# Base URL of your Finance AI Ecosystem FastAPI server
# Default assumes local development on port 8000
FINOPS_URL=http://localhost:8000

# Default tenant ID for all tool calls
# Change this to match your tenant setup
FINOPS_TENANT_ID=default

# API key — leave blank if authentication is not enabled on your server
FINOPS_API_KEY=

# Request timeout in seconds (default 30 — increase for slow analyses)
FINOPS_TIMEOUT=30
